<?xml version="1.0" encoding="UTF-8"?>
<project name="EReader" default="package" basedir=".">
    <property environment="env" />
    <property name="jdk8"      value="/usr/lib/jvm/java-8-openjdk-32" />
    <property name="proguard"  value="${user.home}/tools/proguard6.2.2/lib/proguard.jar" />
    <property name="microemu"  value="${user.home}/netbeans/microemulator-2.0.4/microemulator.jar" />
    <property name="lib.dir"   value="lib" />
    <property name="src.dir"   value="src" />
    <property name="res.dir"   value="res" />
    <property name="build.dir" value="build" />
    <property name="dist.dir"  value="dist" />
    <property name="classes"   value="${build.dir}/classes" />
    <property name="prever"    value="${build.dir}/preverified" />
    <property name="jar.name"  value="EReader.jar" />
    <property name="jad.name"  value="EReader.jad" />

    <path id="libs.path">
        <fileset dir="${lib.dir}"><include name="**/*.jar"/></fileset>
    </path>

    <target name="clean">
        <delete dir="${build.dir}" />
        <delete dir="${dist.dir}" />
    </target>

    <target name="compile">
        <mkdir dir="${classes}" />
        <javac srcdir="${src.dir}"
               destdir="${classes}"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               classpathref="libs.path"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <compilerarg value="-Xlint:-options" />
        </javac>
        <copy todir="${classes}">
            <fileset dir="${res.dir}" erroronmissingdir="false" />
        </copy>
        <unjar src="${lib.dir}/kxml2-2.3.0.jar" dest="${classes}" />
        <unjar src="${lib.dir}/jzlib-cldc.jar" dest="${classes}" />
    </target>

    <target name="preverify" depends="compile">
        <mkdir dir="${prever}" />
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@proguard.pro" />
        </java>
    </target>

    <target name="package" depends="clean,preverify">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${dist.dir}/${jar.name}"
             basedir="${prever}"
             manifest="MANIFEST.MF" />
        <length file="${dist.dir}/${jar.name}" property="jar.size" />
        <echo file="${dist.dir}/${jad.name}">MIDlet-1: EReader, , com.ereader.EReaderMidlet
MIDlet-Name: EReader
MIDlet-Version: 0.2
MIDlet-Vendor: Elchin
MicroEdition-Configuration: CLDC-1.1
MicroEdition-Profile: MIDP-2.0
MIDlet-Jar-URL: ${jar.name}
MIDlet-Jar-Size: ${jar.size}
</echo>
    </target>

    <target name="run" depends="package">
        <java classname="org.microemu.app.Main" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${microemu}" />
                <fileset dir="${lib.dir}" includes="*.jar" />
            </classpath>
            <arg value="${dist.dir}/${jad.name}" />
        </java>
    </target>

    <target name="diagnostic-clean">
        <delete dir="${build.dir}/diagnostic-classes" />
        <delete dir="${build.dir}/diagnostic-preverified" />
        <delete dir="${dist.dir}/launch-probe.jar" />
        <delete dir="${dist.dir}/launch-probe.jad" />
    </target>

    <target name="diagnostic-compile" depends="diagnostic-clean">
        <mkdir dir="${build.dir}/diagnostic-classes" />
        <javac srcdir="diagnostic/src"
               destdir="${build.dir}/diagnostic-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               classpath="${lib.dir}/microemu-jsr-75.jar"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <compilerarg value="-Xlint:-options" />
        </javac>
    </target>

    <target name="diagnostic-preverify" depends="diagnostic-compile">
        <mkdir dir="${build.dir}/diagnostic-preverified" />
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@diagnostic/probe.pro" />
        </java>
    </target>

    <target name="diagnostic" depends="diagnostic-preverify">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${dist.dir}/launch-probe.jar"
             basedir="${build.dir}/diagnostic-preverified"
             manifest="diagnostic/PROBE-MANIFEST.MF" />
        <length file="${dist.dir}/launch-probe.jar" property="probe.jar.size" />
        <echo file="${dist.dir}/launch-probe.jad">MIDlet-1: Launch probe, , com.ereader.diagnostic.LaunchProbeMidlet
MIDlet-Name: EReader launch probe
MIDlet-Version: 0.1
MIDlet-Vendor: Elchin
MicroEdition-Configuration: CLDC-1.1
MicroEdition-Profile: MIDP-2.0
MIDlet-Jar-URL: launch-probe.jar
MIDlet-Jar-Size: ${probe.jar.size}
</echo>
    </target>

    <target name="minimal-clean">
        <delete dir="${build.dir}/minimal-classes" />
        <delete dir="${build.dir}/minimal-preverified" />
        <delete file="${dist.dir}/ereader-core-probe.jar" />
        <delete file="${dist.dir}/ereader-core-probe.jad" />
    </target>

    <target name="minimal-compile" depends="minimal-clean">
        <mkdir dir="${build.dir}/minimal-classes" />
        <javac srcdir="diagnostic/minimal-src"
               destdir="${build.dir}/minimal-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <compilerarg value="-Xlint:-options" />
        </javac>
    </target>

    <target name="minimal-preverify" depends="minimal-compile">
        <mkdir dir="${build.dir}/minimal-preverified" />
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@diagnostic/minimal.pro" />
        </java>
    </target>

    <target name="minimal" depends="minimal-preverify">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${dist.dir}/ereader-core-probe.jar"
             basedir="${build.dir}/minimal-preverified"
             manifest="diagnostic/MINIMAL-MANIFEST.MF" />
        <length file="${dist.dir}/ereader-core-probe.jar" property="minimal.jar.size" />
        <echo file="${dist.dir}/ereader-core-probe.jad">MIDlet-1: EReader core probe, , com.ereader.EReaderMidlet
MIDlet-Name: EReader core probe
MIDlet-Version: 0.1
MIDlet-Vendor: Elchin
MicroEdition-Configuration: CLDC-1.1
MicroEdition-Profile: MIDP-2.0
MIDlet-Jar-URL: ereader-core-probe.jar
MIDlet-Jar-Size: ${minimal.jar.size}
</echo>
    </target>

    <target name="settings-clean">
        <delete dir="${build.dir}/settings-classes" />
        <delete dir="${build.dir}/settings-preverified" />
        <delete file="${dist.dir}/ereader-settings-probe.jar" />
        <delete file="${dist.dir}/ereader-settings-probe.jad" />
    </target>

    <target name="settings-compile" depends="settings-clean">
        <mkdir dir="${build.dir}/settings-classes" />
        <javac srcdir="diagnostic/settings-src"
               destdir="${build.dir}/settings-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               classpath="${src.dir}"
               sourcepath="${src.dir}"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <include name="**/*.java" />
            <compilerarg value="-Xlint:-options" />
        </javac>
        <javac srcdir="${src.dir}"
               destdir="${build.dir}/settings-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <include name="com/ereader/model/Settings.java" />
            <include name="com/ereader/util/Utf8.java" />
            <include name="com/ereader/store/SettingsStore.java" />
            <compilerarg value="-Xlint:-options" />
        </javac>
    </target>

    <target name="settings-preverify" depends="settings-compile">
        <mkdir dir="${build.dir}/settings-preverified" />
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@diagnostic/settings.pro" />
        </java>
    </target>

    <target name="settings" depends="settings-preverify">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${dist.dir}/ereader-settings-probe.jar"
             basedir="${build.dir}/settings-preverified"
             manifest="diagnostic/SETTINGS-MANIFEST.MF" />
        <length file="${dist.dir}/ereader-settings-probe.jar" property="settings.jar.size" />
        <echo file="${dist.dir}/ereader-settings-probe.jad">MIDlet-1: EReader settings probe, , com.ereader.EReaderMidlet
MIDlet-Name: EReader settings probe
MIDlet-Version: 0.1
MIDlet-Vendor: Elchin
MicroEdition-Configuration: CLDC-1.1
MicroEdition-Profile: MIDP-2.0
MIDlet-Jar-URL: ereader-settings-probe.jar
MIDlet-Jar-Size: ${settings.jar.size}
</echo>
    </target>

    <target name="library-clean">
        <delete dir="${build.dir}/library-classes" />
        <delete dir="${build.dir}/library-preverified" />
        <delete file="${dist.dir}/ereader-library-probe.jar" />
        <delete file="${dist.dir}/ereader-library-probe.jad" />
    </target>

    <target name="library-compile" depends="library-clean">
        <mkdir dir="${build.dir}/library-classes" />
        <javac srcdir="${src.dir}"
               destdir="${build.dir}/library-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <include name="com/ereader/model/Book.java" />
            <include name="com/ereader/model/Settings.java" />
            <include name="com/ereader/store/LibraryStore.java" />
            <include name="com/ereader/util/Utf8.java" />
            <include name="com/ereader/ui/Theme.java" />
            <include name="com/ereader/ui/LibraryCanvas.java" />
            <compilerarg value="-Xlint:-options" />
        </javac>
        <javac srcdir="diagnostic/library-src"
               destdir="${build.dir}/library-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               classpath="${build.dir}/library-classes"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <compilerarg value="-Xlint:-options" />
        </javac>
    </target>

    <target name="library-preverify" depends="library-compile">
        <mkdir dir="${build.dir}/library-preverified" />
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@diagnostic/library.pro" />
        </java>
    </target>

    <target name="library" depends="library-preverify">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${dist.dir}/ereader-library-probe.jar"
             basedir="${build.dir}/library-preverified"
             manifest="diagnostic/LIBRARY-MANIFEST.MF" />
        <length file="${dist.dir}/ereader-library-probe.jar" property="library.jar.size" />
        <echo file="${dist.dir}/ereader-library-probe.jad">MIDlet-1: EReader library probe, , com.ereader.EReaderMidlet
MIDlet-Name: EReader library probe
MIDlet-Version: 0.1
MIDlet-Vendor: Elchin
MicroEdition-Configuration: CLDC-1.1
MicroEdition-Profile: MIDP-2.0
MIDlet-Jar-URL: ereader-library-probe.jar
MIDlet-Jar-Size: ${library.jar.size}
</echo>
    </target>

    <target name="screens-clean">
        <delete dir="${build.dir}/screens-classes" />
        <delete dir="${build.dir}/screens-preverified" />
        <delete file="${dist.dir}/ereader-screens-probe.jar" />
        <delete file="${dist.dir}/ereader-screens-probe.jad" />
    </target>

    <target name="screens-compile" depends="screens-clean">
        <mkdir dir="${build.dir}/screens-classes" />
        <javac srcdir="${src.dir}"
               destdir="${build.dir}/screens-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <include name="com/ereader/model/Book.java" />
            <include name="com/ereader/model/Settings.java" />
            <include name="com/ereader/store/LibraryStore.java" />
            <include name="com/ereader/util/Utf8.java" />
            <include name="com/ereader/ui/Theme.java" />
            <include name="com/ereader/ui/LibraryCanvas.java" />
            <include name="com/ereader/ui/SettingsCanvas.java" />
            <compilerarg value="-Xlint:-options" />
        </javac>
        <javac srcdir="diagnostic/screens-src"
               destdir="${build.dir}/screens-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               classpath="${build.dir}/screens-classes"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <compilerarg value="-Xlint:-options" />
        </javac>
    </target>

    <target name="screens-preverify" depends="screens-compile">
        <mkdir dir="${build.dir}/screens-preverified" />
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@diagnostic/screens.pro" />
        </java>
    </target>

    <target name="screens" depends="screens-preverify">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${dist.dir}/ereader-screens-probe.jar"
             basedir="${build.dir}/screens-preverified"
             manifest="diagnostic/SCREENS-MANIFEST.MF" />
        <length file="${dist.dir}/ereader-screens-probe.jar" property="screens.jar.size" />
        <echo file="${dist.dir}/ereader-screens-probe.jad">MIDlet-1: EReader screens probe, , com.ereader.EReaderMidlet
MIDlet-Name: EReader screens probe
MIDlet-Version: 0.1
MIDlet-Vendor: Elchin
MicroEdition-Configuration: CLDC-1.1
MicroEdition-Profile: MIDP-2.0
MIDlet-Jar-URL: ereader-screens-probe.jar
MIDlet-Jar-Size: ${screens.jar.size}
</echo>
    </target>

    <target name="browser-clean">
        <delete dir="${build.dir}/browser-classes" />
        <delete dir="${build.dir}/browser-preverified" />
        <delete file="${dist.dir}/ereader-browser-probe.jar" />
        <delete file="${dist.dir}/ereader-browser-probe.jad" />
    </target>

    <target name="browser-compile" depends="browser-clean">
        <mkdir dir="${build.dir}/browser-classes" />
        <javac srcdir="${src.dir}"
               destdir="${build.dir}/browser-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               classpath="${lib.dir}/microemu-jsr-75.jar"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <include name="com/ereader/model/Book.java" />
            <include name="com/ereader/model/Settings.java" />
            <include name="com/ereader/ui/Theme.java" />
            <include name="com/ereader/ui/LibraryCanvas.java" />
            <include name="com/ereader/ui/FileBrowserCanvas.java" />
            <compilerarg value="-Xlint:-options" />
        </javac>
        <javac srcdir="diagnostic/browser-src"
               destdir="${build.dir}/browser-classes"
               source="1.4" target="1.4"
               bootclasspath="${lib.dir}/cldcapi11.jar:${lib.dir}/midpapi20.jar:${lib.dir}/microemu-nokiaui.jar"
               classpath="${build.dir}/browser-classes:${lib.dir}/microemu-jsr-75.jar"
               encoding="UTF-8"
               includeantruntime="false"
               fork="true"
               executable="${jdk8}/bin/javac">
            <compilerarg value="-Xlint:-options" />
        </javac>
    </target>

    <target name="browser-preverify" depends="browser-compile">
        <mkdir dir="${build.dir}/browser-preverified" />
        <java jar="${proguard}" fork="true" failonerror="true">
            <arg value="@diagnostic/browser.pro" />
        </java>
    </target>

    <target name="browser" depends="browser-preverify">
        <mkdir dir="${dist.dir}" />
        <jar destfile="${dist.dir}/ereader-browser-probe.jar"
             basedir="${build.dir}/browser-preverified"
             manifest="diagnostic/BROWSER-MANIFEST.MF" />
        <length file="${dist.dir}/ereader-browser-probe.jar" property="browser.jar.size" />
        <echo file="${dist.dir}/ereader-browser-probe.jad">MIDlet-1: EReader browser probe, , com.ereader.EReaderMidlet
MIDlet-Name: EReader browser probe
MIDlet-Version: 0.1
MIDlet-Vendor: Elchin
MicroEdition-Configuration: CLDC-1.1
MicroEdition-Profile: MIDP-2.0
MIDlet-Jar-URL: ereader-browser-probe.jar
MIDlet-Jar-Size: ${browser.jar.size}
</echo>
    </target>

    <target name="sign" depends="package">
        <fail unless="sign.keystore"
              message="Use -Dsign.keystore=... to select the keystore." />
        <fail unless="sign.storepass"
              message="Use -Dsign.storepass=... to provide the keystore password." />
        <fail unless="sign.alias"
              message="Use -Dsign.alias=... to select the signing alias." />
        <exec executable="${jdk8}/bin/jarsigner" failonerror="true">
            <arg value="-keystore" />
            <arg value="${sign.keystore}" />
            <arg value="-storepass" />
            <arg value="${sign.storepass}" />
            <arg value="${dist.dir}/${jar.name}" />
            <arg value="${sign.alias}" />
        </exec>
        <length file="${dist.dir}/${jar.name}" property="sign.jar.size" />
        <replaceregexp file="${dist.dir}/${jad.name}"
                       match="MIDlet-Jar-Size: .*"
                       replace="MIDlet-Jar-Size: ${sign.jar.size}"
                       byline="true" />
    </target>
</project>
